/bin/
*.prof
.DS_Store

# wasm build artifacts — rebuilt by `make wasm` locally and by the
# deploy pipeline. Source-of-truth is cmd/6502-wasm/*.go and web/{index.html, sim.js}.
/web/sim.wasm
/web/core.wasm
/web/go6asm.wasm
/web/wasm_exec.js
/web/foxpro.js

.claude/

# Local multi-module Go workspace (per-developer; lives at the parent
# dir, but ignore here too so a stray in-repo one is never committed).
go.work
go.work.sum

# Defensive ignores: this is a Go repo, but sibling Node/Astro projects
# (thecarledwards-site) sometimes leak their build caches in here if a
# build command runs from the wrong cwd. Never commit them.
/.astro/
/node_modules/